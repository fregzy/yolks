#!/bin/bash
# vndel-node — starts a customer's Node.js app, whatever it is. The egg's startup command is just "vndel-node";
# everything is steered by the egg variables (they arrive as environment variables):
#
#   COMMAND           what to run. A file (index.js, bot.mjs, src/main.ts) is run with the right runner; anything else
#                     ("npm run start", "node --inspect app.js") is run as it is. Empty: the package.json "start"
#                     script, else its "main", else the first of index.js / index.ts / src/index.ts / main.js / bot.js …
#   NODE_ARGS         extra flags for node (e.g. --enable-source-maps)
#   AUTO_UPDATE       1: "git pull" before starting (when the folder is a git checkout)
#   NODE_PACKAGES     packages to add (npm install …);  UNNODE_PACKAGES: packages to remove
#   INSTALL_DEPS      1 (default): install package.json's dependencies (npm, or yarn / pnpm when their lock file is
#                     there) — skipped when nothing changed since the last start
#   AUTO_DEPS         1: also install packages the code require()s / imports but package.json does not list
#   TS_RUNNER         ts-node (default) or tsx, for .ts files;  TS_TYPECHECK=1: let ts-node stop on type errors
#   NODE_MEMORY_AUTO  1 (default): limit node's heap to 75% of the server's memory, so it does not get OOM-killed
#
# Every step only warns when it fails: the app is still started, and its own error shows what is missing.
set -u

SERVER_DIR="${SERVER_DIR:-/home/container}"
GLOBAL_MODULES="${VNDEL_GLOBAL_MODULES:-/usr/local/lib/node_modules}"
AUTODEPS="${VNDEL_AUTODEPS:-/usr/local/lib/vndel/autodeps.js}"
cd "${SERVER_DIR}" || exit 1

say() { printf '\033[1;36m[vndel]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[vndel]\033[0m %s\n' "$*"; }
fail() { printf '\033[1;31m[vndel] %s\033[0m\n' "$*"; exit 1; }
on() { case "${1:-}" in 1 | true | TRUE | True | yes | on) return 0 ;; esac; return 1; }
words() { read -r -a WORDS <<<"${1:-}"; }

# a value from package.json (empty when there is none): pkg 'scripts.start'
pkg() {
    [ -f package.json ] || return 0
    node -e 'try { let v = require(process.cwd() + "/package.json"); for (const k of process.argv[1].split(".")) v = v == null ? undefined : v[k]; if (typeof v === "string") process.stdout.write(v); } catch (e) {}' "$1" 2>/dev/null
}

say "Node $(node -v 2>/dev/null || echo '?') · npm $(npm -v 2>/dev/null || echo '?')"

# ── 1 · the code ──────────────────────────────────────────────────────────────────────────────────
if on "${AUTO_UPDATE:-0}" && [ -d .git ]; then
    say "AUTO_UPDATE: git pull"
    git pull --ff-only || warn "git pull failed — starting with the files as they are"
fi

# ── 2 · packages ──────────────────────────────────────────────────────────────────────────────────
if [ -n "${NODE_PACKAGES:-}" ]; then
    words "${NODE_PACKAGES}"
    say "adding: ${WORDS[*]}"
    npm install --no-audit --no-fund "${WORDS[@]}" || warn "npm install ${WORDS[*]} failed"
fi
if [ -n "${UNNODE_PACKAGES:-}" ]; then
    words "${UNNODE_PACKAGES}"
    say "removing: ${WORDS[*]}"
    npm uninstall --no-audit --no-fund "${WORDS[@]}" || warn "npm uninstall ${WORDS[*]} failed"
fi

# package.json's dependencies, with the project's own package manager — only when something changed
if [ -f pnpm-lock.yaml ] && command -v pnpm >/dev/null 2>&1; then PM=pnpm
elif [ -f yarn.lock ] && command -v yarn >/dev/null 2>&1; then PM=yarn
else PM=npm
fi
STAMP=node_modules/.vndel-installed
fingerprint() { cat package.json package-lock.json npm-shrinkwrap.json yarn.lock pnpm-lock.yaml 2>/dev/null | { sha256sum 2>/dev/null || cksum; } | cut -d' ' -f1; printf '%s %s\n' "$(node -v 2>/dev/null)" "${PM}"; }
INSTALLED=1
if on "${INSTALL_DEPS:-1}" && [ -f package.json ]; then
    if [ -d node_modules ] && [ -f "${STAMP}" ] && [ "$(cat "${STAMP}")" = "$(fingerprint)" ]; then
        say "dependencies are up to date"
    else
        say "installing dependencies (${PM})…"
        case "${PM}" in
            pnpm) pnpm install ;;
            yarn) yarn install --non-interactive ;;
            *) npm install --no-audit --no-fund ;;
        esac || { INSTALLED=0; warn "installing the dependencies failed — see above"; }
    fi
fi

if on "${AUTO_DEPS:-0}"; then
    if [ -f "${AUTODEPS}" ]; then node "${AUTODEPS}" || warn "autodeps failed"; else warn "autodeps is not in this image"; fi
fi
# remembered after autodeps (it may add to package.json), so the next start skips the install
if [ "${INSTALLED}" = 1 ] && [ -f package.json ] && [ -d node_modules ]; then fingerprint >"${STAMP}" 2>/dev/null || true; fi

# ── 3 · the environment ───────────────────────────────────────────────────────────────────────────
if on "${NODE_MEMORY_AUTO:-1}" && [[ "${SERVER_MEMORY:-0}" =~ ^[0-9]+$ ]] && [ "${SERVER_MEMORY:-0}" -ge 128 ] \
    && [[ "${NODE_OPTIONS:-}" != *max-old-space-size* ]] && [[ "${NODE_ARGS:-}" != *max-old-space-size* ]]; then
    export NODE_OPTIONS="${NODE_OPTIONS:+${NODE_OPTIONS} }--max-old-space-size=$((SERVER_MEMORY * 75 / 100))"
fi
on "${TS_TYPECHECK:-0}" || export TS_NODE_TRANSPILE_ONLY=true

# ── 4 · run ───────────────────────────────────────────────────────────────────────────────────────
words "${NODE_ARGS:-}"
NODE_FLAGS=("${WORDS[@]}")

run_file() {
    local file="$1"
    shift
    [ -f "${file}" ] || fail "${file} was not found in the server folder. Upload your files, or set the start file / command (COMMAND)."
    case "${file}" in
        *.ts | *.mts | *.cts | *.tsx)
            local esm=0
            if [[ "${file}" == *.mts ]] || [ "$(pkg type)" = "module" ]; then esm=1; fi
            local runner="${TS_RUNNER:-ts-node}"
            if [ "${runner}" = ts-node ] && [ "${esm}" = 1 ] && { [ -x node_modules/.bin/tsx ] || command -v tsx >/dev/null 2>&1; }; then
                say "ES module TypeScript: using tsx (ts-node needs extra setup for ES modules)"
                runner=tsx
            fi
            if [ "${runner}" = tsx ]; then
                local tsx=tsx
                [ -x node_modules/.bin/tsx ] && tsx=node_modules/.bin/tsx
                command -v "${tsx}" >/dev/null 2>&1 || fail "tsx is not available for this Node version — set TS_RUNNER to ts-node."
                say "starting: tsx ${file}"
                exec "${tsx}" "${NODE_FLAGS[@]}" "${file}" "$@"
            fi
            # ts-node: the project's own if it has one, else the image's
            local tsnode="${GLOBAL_MODULES}/ts-node"
            [ -d node_modules/ts-node ] && tsnode="${SERVER_DIR}/node_modules/ts-node"
            [ -d "${tsnode}" ] || fail "ts-node is not installed — add it: NODE_PACKAGES=ts-node typescript"
            say "starting: ts-node ${file}"
            if [ "${esm}" = 1 ]; then
                exec node "${NODE_FLAGS[@]}" --loader "file://${tsnode}/esm.mjs" "${file}" "$@"
            fi
            exec node "${NODE_FLAGS[@]}" -r "${tsnode}/register" "${file}" "$@"
            ;;
        *)
            say "starting: node ${file}"
            exec node "${NODE_FLAGS[@]}" "${file}" "$@"
            ;;
    esac
}

CMD="$(printf '%s' "${COMMAND:-}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
FILE_RE='^[A-Za-z0-9_./@+-]+\.(js|mjs|cjs|jsx|ts|mts|cts|tsx)$'

if [ -z "${CMD}" ]; then
    if [ -n "$(pkg scripts.start)" ]; then
        say "starting: npm start ($(pkg scripts.start))"
        exec npm start
    fi
    main="$(pkg main)"
    for f in "${main}" index.js index.ts src/index.ts src/index.js main.js main.ts bot.js bot.ts app.js app.ts server.js dist/index.js; do
        if [ -n "${f}" ] && [ -f "${f}" ]; then run_file "${f}"; fi
    done
    fail "No start file found (index.js, index.ts, src/index.ts, …) and package.json has no \"start\" script. Set the start file / command (COMMAND)."
fi

words "${CMD}"
if [[ "${CMD}" =~ ${FILE_RE} ]]; then
    run_file "${CMD}"
fi
# "node something.ts …": node cannot run TypeScript by itself on every version — use the TypeScript runner
if [ "${WORDS[0]}" = node ] && [ "${#WORDS[@]}" -ge 2 ] && [[ "${WORDS[1]}" =~ \.(ts|mts|cts|tsx)$ ]]; then
    run_file "${WORDS[1]}" "${WORDS[@]:2}"
fi
say "starting: ${CMD}"
exec bash -c "${CMD}"
